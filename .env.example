# Copy this file to .env and fill in real values. .env is gitignored.

# --- Local Postgres (docker-compose "db" service) ---
POSTGRES_USER=trailwise
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=trailwise
POSTGRES_PORT=5432

# --- Backend connection string ---
# Local docker-compose Postgres (commented out):
CONNECTION_STRING=Host=db;Port=5432;Database=trailwise;Username=trailwise;Password=change_me_dev_password

# Supabase cloud Postgres:
# CONNECTION_STRING=Host=aws-0-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.obtxrpwhcwqaozlstkfa;Password=Trailwise@2026;SSL Mode=Require;Trust Server Certificate=true

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_ISSUER=TrailWise
JWT_AUDIENCE=TrailWiseClients
JWT_EXPIRY_MINUTES=60

# --- Seeded Admin account (created on first backend startup if it doesn't already exist) ---
ADMIN_SEED_NAME=System Admin
ADMIN_SEED_EMAIL=admin@trailwise.local
ADMIN_SEED_PASSWORD=ChangeMe123!

# --- CORS ---
CORS_ALLOWED_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGIN_FLUTTER=http://localhost:5000

# --- Groq LLM (cloud, powers the coordinator's Preference Extraction and Proposal Summary
# agents) --- Disabled by default. Get a free API key at https://console.groq.com, then set
# LLM_ENABLED=true and GROQ_API_KEY below. See docs/coordinator-agent.md for details, including
# the tradeoff of moving from a fully local model to this cloud API (an API key is now required,
# and the traveler's free-text SpecialRequests is sent to Groq's servers during extraction).
LLM_ENABLED=true
GROQ_API_KEY=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
LLM_EXTRACTION_MODEL=openai/gpt-oss-120b
LLM_SUMMARY_MODEL=openai/gpt-oss-120b

#----Notify.lk settings-----(dulitha's details)
# NOTIFY_LK_USER_ID=33215
# NOTIFY_LK_API_KEY=DEYsYa87zc4jZ13kuOro
# NOTIFY_LK_SENDER_ID=NotifyDEMO
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=

# --- Backend port exposed to the host ---
BACKEND_PORT=5080

# --- React dev server ---
FRONTEND_WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:5080

